# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=tradeflow
POSTGRES_USER=tradeflow
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Browser security / frontend development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production security (review before deployment)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Notifications / SMS
SMS_ENABLED=False
SMS_PROVIDER=MOCK
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_TIMEOUT=10